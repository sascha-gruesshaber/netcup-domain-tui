{
  "name": "netcup-dns-tui",
  "version": "0.1.0",
  "description": "Terminal UI to manage DNS records of your netcup domains via the netcup CCP API",
  "type": "module",
  "bin": {
    "netcup-dns": "./dist/netcup-dns.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "demo": "tsx scripts/demo.ts",
    "screenshots": "tsx scripts/screenshots.tsx",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "build": "node scripts/build.mjs",
    "start": "node dist/netcup-dns.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
